# Copy this file to `.env` and fill in your own values. NEVER commit the real `.env` file —
# it's already listed in .gitignore. This file (.env.example) contains no real secrets and is
# safe to commit.

# Required: your bot's token from @BotFather on Telegram.
BOT_TOKEN=

# Required for the automatic daily report (Section: Daily Automation). Optional otherwise.
# This is the numeric chat ID the bot should push the daily report to (your own DM with the
# bot, or a group/channel it's in). Easiest way to get it: message your bot once, then visit
# https://api.telegram.org/bot<your token>/getUpdates and read "chat":{"id": ...} from the
# response — or use a helper bot like @userinfobot / @getidsbot.
CHAT_ID=

# Optional: where to put the persistent JSON store + generated PDF reports. Defaults to a
# `data/` folder next to the script if not set. Must point at a persistent disk (see README.md).
PORTFOLIO_BOT_DATA_DIR=

# Optional: automatic daily report settings (see README.md → "Daily automated report").
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR_UTC=13
